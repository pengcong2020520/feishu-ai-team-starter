    {
      "from": "writer",
      "to": "reviewer",
      "kind": "dispatch"
    }
  ],
  "nodes": [
    {
      "id": "draft",
      "name": "起草简报",
      "type": "task",
      "role": "writer",
      "skills": [
        "writer-method"
      ],
      "prompt": "目标：{{demand}}。意见：{{feedback}}。写三句简报到 drafts/brief.md。",
