  "examples": [
    {
      "name": "五角色协作演示（虚构公司）",
      "demand": "对 inputs/demo.md 的虚构青禾软件做综合研究，仅验证研究协作，不当作真实投资依据。让公司、宏观、量化、风险四个专家分别工作；调用 company-snapshot、macro-outlook、performance-comparison、risk-assessment、scenario-analysis、thesis-review，主理人用 full-analysis 汇总。只使用给定演示数据，列出计算步骤、反证与缺口。",
      "expectedArtifacts": [
        "report"
      ]
    },
    {
      "name": "真实公司研究（请补来源）",
      "demand": "请研究【公司名称】，研究截至日期【日期】，目标【研究问题】。我的公开原始资料 URL：【请填写】。先确认范围，再按需组织专家，区分来源事实与推断；缺数据先列清单，不补造行情。",
      "expectedArtifacts": [
        "report"
      ]
    }
  ]
}
