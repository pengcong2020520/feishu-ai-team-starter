# 复制为 .env（权限 600）后填写；.env 不要提交、不要贴进聊天
FEISHU_PRODUCT_APP_ID=cli_xxx
FEISHU_PRODUCT_APP_SECRET=xxx
FEISHU_DESIGNER_APP_ID=cli_xxx
FEISHU_DESIGNER_APP_SECRET=xxx
FEISHU_DEVELOPER_APP_ID=cli_xxx
FEISHU_DEVELOPER_APP_SECRET=xxx
# 兼容 Claude 接口的模型，例如火山方舟 https://ark.cn-beijing.volces.com/api/compatible
MODEL_BASE_URL=https://example.com/api/compatible
MODEL_API_KEY=xxx
MODEL_NAME=xxx
# 可选：Chrome 可执行文件路径；macOS 不填时使用系统默认安装位置
CHROME_PATH=
# 部署时可选：容器内监听 0.0.0.0；下面两个地址用于生成飞书卡片链接和工作台预览链接
PREVIEW_HOST=127.0.0.1
PUBLIC_WORKBENCH_BASE=http://127.0.0.1:4870
PUBLIC_PREVIEW_BASE=http://127.0.0.1:4871
