# 复制为 .env（权限 600）后填写；.env 不要提交、不要贴进聊天
# basic 启航版：原群协作；projects 领航版：独立群和人员分工。用 node setup.mjs mode 选择。
TEAM_MODE=basic
FEISHU_PRODUCT_APP_ID=cli_xxx
FEISHU_PRODUCT_APP_SECRET=xxx
FEISHU_DESIGNER_APP_ID=cli_xxx
FEISHU_DESIGNER_APP_SECRET=xxx
FEISHU_DEVELOPER_APP_ID=cli_xxx
FEISHU_DEVELOPER_APP_SECRET=xxx
# AI 管理员助手（第 4 张码，node setup.mjs scan 时自动写入；OPEN_ID 是扫码的管理员，不是密钥）；不填时只跑团队服务
FEISHU_ADMIN_APP_ID=
FEISHU_ADMIN_APP_SECRET=
FEISHU_ADMIN_OPEN_ID=
# 兼容 Claude 接口的模型，例如火山方舟 https://ark.cn-beijing.volces.com/api/compatible
MODEL_BASE_URL=https://example.com/api/compatible
MODEL_API_KEY=xxx
MODEL_NAME=xxx
# 可选：Chrome 可执行文件路径；macOS 不填时使用系统默认安装位置
CHROME_PATH=
# 工作台端口（模型写的页面用下一个端口）；被别的程序占用时 setup 会自动改
PREVIEW_PORT=4870
# 全团队最多同时运行的模型任务数（包括管理员助手）；其余排队，按机器资源调整
AGENT_CONCURRENCY=3
# 部署时才需要（compose.yaml 里已经设好）：容器内监听 0.0.0.0；两个地址用于生成飞书卡片和工作台里的链接，不填就按 PREVIEW_PORT 生成本机地址
# PREVIEW_HOST=0.0.0.0
# PUBLIC_WORKBENCH_BASE=http://127.0.0.1:4880
# PUBLIC_PREVIEW_BASE=http://127.0.0.1:4881

# 团队包可选配置：不同角色模型档位（未填沿用 MODEL_NAME）
MODEL_STRONG_NAME=
MODEL_FAST_NAME=
# 实时公开网页搜索；不配置时可向研究角色提供具体 HTTPS 来源
BRAVE_SEARCH_API_KEY=
